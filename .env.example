# copy to .env and adjust paths as needed
DATABASE_URL=mysql+pymysql://root:password@localhost:3307/communicator
# JWT
JWT_SECRET=supersecret_change_me
JWT_ALG=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# Static storage
STORAGE_ROOT=/app/storage
UPLOADS_ROOT=/app/uploads
PUBLIC_BASE_URL=http://localhost:8000

# Models / Services
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=phi3:latest
WHISPER_CPP_BIN=/usr/local/bin/whisper_main   # set to your whisper.cpp binary (or leave blank to use stub)
WHISPER_MODEL=medium
YOURTTS_URL=                                 # leave blank if using in-proc stub

# Realtime tunables
STT_PARTIAL_MS=300
TTS_CHUNK_MS=240
